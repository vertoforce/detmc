{
  "schemaVersion": 1,
  "id": "detmc",
  "version": "${version}",
  "name": "detmc",
  "description": "Deterministic RNG for headless Minecraft servers: same world seed + same -Ddetmc.seed replays identically.",
  "authors": ["vertoforce"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.detmc.fabric.DetMcFabric"]
  },
  "mixins": ["detmc.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}

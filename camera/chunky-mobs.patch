diff --git a/chunky/src/java/se/llbit/chunky/entity/VillagerEntity.java b/chunky/src/java/se/llbit/chunky/entity/VillagerEntity.java
new file mode 100644
index 00000000..2766a0b2
--- /dev/null
+++ b/chunky/src/java/se/llbit/chunky/entity/VillagerEntity.java
@@ -0,0 +1,255 @@
+/* Copyright (c) 2026 Chunky contributors
+ *

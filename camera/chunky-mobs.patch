+package se.llbit.chunky.entity;
+
+import se.llbit.chunky.block.Block;
+import se.llbit.chunky.block.BlockProvider;
+import se.llbit.chunky.block.BlockSpec;
+import se.llbit.chunky.model.builder.BoxModelBuilder;
+import se.llbit.chunky.resources.Texture;
+import se.llbit.chunky.world.Material;
+import se.llbit.chunky.world.material.TextureMaterial;
+import se.llbit.json.JsonObject;
+import se.llbit.json.JsonValue;
+import se.llbit.math.Quad;
+import se.llbit.math.QuickMath;
+import se.llbit.math.Transform;
+import se.llbit.math.Vector3;
+import se.llbit.math.primitive.Primitive;
+import se.llbit.nbt.CompoundTag;
+import se.llbit.nbt.Tag;
+import se.llbit.util.JsonUtil;
+
+import java.util.ArrayList;
+import java.util.Collection;
+
+/**
+ * An enderman. Geometry follows vanilla EndermanModel (a HumanoidModel mesh with a
+ * -14 pixel y offset and 30 pixel long limbs) on a 64x32 texture.
+ * <p>
+ * Vanilla model coordinates are y-down with the origin 24 pixels above the feet;
+ * Chunky's are y-up with the origin at the feet, so each box is built with its own
+ * pivot at the origin and y negated, then translated to (pivot.x, 24 - pivot.y, pivot.z).
+ */
+public class EndermanEntity extends Entity implements Poseable {
+
+  private static final Quad[] head = new BoxModelBuilder()
+    .addBox(new Vector3(-4 / 16.0, 0, -4 / 16.0), new Vector3(4 / 16.0, 8 / 16.0, 4 / 16.0), box ->
+      box.forTextureSize(64, 32).atUVCoordinates(0, 0).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  /** Same box as the head, grown a hair so the emissive eye overlay does not z-fight. */
+  private static final Quad[] eyes = new BoxModelBuilder()
+    .addBox(new Vector3(-4 / 16.0, 0, -4 / 16.0), new Vector3(4 / 16.0, 8 / 16.0, 4 / 16.0), box ->
+      box.forTextureSize(64, 32).atUVCoordinates(0, 0).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+        .grow(0.001)
+    ).toQuads();
+
+  private static final Quad[] body = new BoxModelBuilder()
+    .addBox(new Vector3(-4 / 16.0, -12 / 16.0, -2 / 16.0), new Vector3(4 / 16.0, 0, 2 / 16.0), box ->
+      box.forTextureSize(64, 32).atUVCoordinates(32, 16).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  private static final Quad[] arm = new BoxModelBuilder()
+    .addBox(new Vector3(-1 / 16.0, -28 / 16.0, -1 / 16.0), new Vector3(1 / 16.0, 2 / 16.0, 1 / 16.0), box ->
+      box.forTextureSize(64, 32).atUVCoordinates(56, 0).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  private static final Quad[] leg = new BoxModelBuilder()
+    .addBox(new Vector3(-1 / 16.0, -30 / 16.0, -1 / 16.0), new Vector3(1 / 16.0, 0, 1 / 16.0), box ->
+      box.forTextureSize(64, 32).atUVCoordinates(56, 0).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  /** Unit cube for the carried block, centred on the origin. */
+  private static final Quad[] carried = new BoxModelBuilder()
+    .addBox(new Vector3(-0.5, -0.5, -0.5), new Vector3(0.5, 0.5, 0.5), box ->
+      box.forTextureSize(16, 16).atUVCoordinates(0, 0)
+        .addTopFace(s -> s.set(0, 16, 0, 16))
+        .addBottomFace(s -> s.set(0, 16, 0, 16))
+        .addLeftFace(s -> s.set(0, 16, 0, 16))
+        .addRightFace(s -> s.set(0, 16, 0, 16))
+        .addFrontFace(s -> s.set(0, 16, 0, 16))
+        .addBackFace(s -> s.set(0, 16, 0, 16))
+    ).toQuads();
+
+  private static final String[] partNames =
+    {"all", "head", "body", "left_arm", "right_arm", "left_leg", "right_leg"};
+
+  private final JsonObject pose;
+  private double scale = 1;
+  private double headScale = 1;
+  /** Block held over the enderman's hands, or null. */
+  private final CompoundTag carriedBlock;
+
+  public EndermanEntity(Vector3 position, CompoundTag tag) {
+    super(position);
+
+    Tag rotation = tag.get("Rotation");
+    double yaw = rotation.get(0).floatValue();
+    double pitch = rotation.get(1).floatValue();
+
+    Tag carried = tag.get("carriedBlockState");
+    this.carriedBlock = carried.isCompoundTag() ? carried.asCompound() : null;
+
+    pose = new JsonObject();
+    pose.add("all", JsonUtil.vec3ToJson(new Vector3(0, QuickMath.degToRad(180 - yaw), 0)));
+    pose.add("head", JsonUtil.vec3ToJson(new Vector3(QuickMath.degToRad(-pitch), 0, 0)));
+  }
+
+  public EndermanEntity(JsonObject json) {
+    super(JsonUtil.vec3FromJsonObject(json.get("position")));
+    this.scale = json.get("scale").asDouble(1);
+    this.headScale = json.get("headScale").asDouble(1);
+    this.pose = json.get("pose").object();
+    this.carriedBlock = null;
+  }
+
+  @Override
+  public Collection<Primitive> primitives(Vector3 offset) {
+    ArrayList<Primitive> faces = new ArrayList<>();
+
+    TextureMaterial skin = new TextureMaterial(Texture.enderman);
+    TextureMaterial eyeMaterial = new TextureMaterial(Texture.endermanEyes);
+    eyeMaterial.emittance = 1.0f;
+
+    Vector3 allPose = JsonUtil.vec3FromJsonArray(pose.get("all"));
+    Vector3 headPose = JsonUtil.vec3FromJsonArray(pose.get("head"));
+    Vector3 bodyPose = JsonUtil.vec3FromJsonArray(pose.get("body"));
+    Vector3 leftArmPose = JsonUtil.vec3FromJsonArray(pose.get("left_arm"));
+    Vector3 rightArmPose = JsonUtil.vec3FromJsonArray(pose.get("right_arm"));
+    Vector3 leftLegPose = JsonUtil.vec3FromJsonArray(pose.get("left_leg"));
+    Vector3 rightLegPose = JsonUtil.vec3FromJsonArray(pose.get("right_leg"));
+
+    Vector3 worldOffset = new Vector3(position.x + offset.x, position.y + offset.y, position.z + offset.z);
+    Transform worldTransform = Transform.NONE
+      .scale(scale)
+      .rotateX(allPose.x)
+      .rotateY(allPose.y)
+      .rotateZ(allPose.z)
+      .translate(worldOffset);
+
+    Transform transform = Transform.NONE
+      .rotateX(headPose.x).rotateY(headPose.y).rotateZ(headPose.z)
+      .scale(headScale)
+      .translate(0, 38 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : head) {
+      quad.addTriangles(faces, skin, transform);
+    }
+    for (Quad quad : eyes) {
+      quad.addTriangles(faces, eyeMaterial, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(bodyPose.x).rotateY(bodyPose.y).rotateZ(bodyPose.z)
+      .translate(0, 38 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : body) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(rightArmPose.x).rotateY(rightArmPose.y).rotateZ(rightArmPose.z)
+      .translate(5 / 16.0, 36 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : arm) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(leftArmPose.x).rotateY(leftArmPose.y).rotateZ(leftArmPose.z)
+      .translate(-5 / 16.0, 36 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : arm) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(rightLegPose.x).rotateY(rightLegPose.y).rotateZ(rightLegPose.z)
+      .translate(2 / 16.0, 29 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : leg) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(leftLegPose.x).rotateY(leftLegPose.y).rotateZ(leftLegPose.z)
+      .translate(-2 / 16.0, 29 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : leg) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    Material carriedMaterial = carriedBlockMaterial();
+    if (carriedMaterial != null) {
+      // Vanilla holds the block half size, 0.6875 below the model origin and 0.75
+      // in front, tilted; this reproduces the placement, not the exact tilt chain.
+      transform = Transform.NONE
+        .scale(0.5)
+        .rotateY(Math.toRadians(45))
+        .rotateX(Math.toRadians(-20))
+        .translate(0, 0.8125, -0.75)
+        .chain(worldTransform);
+      for (Quad quad : carried) {
+        quad.addTriangles(faces, carriedMaterial, transform);
+      }
+    }
+
+    return faces;
+  }
+
+  /** Resolves carriedBlockState through the registered block providers. */
+  private Material carriedBlockMaterial() {
+    if (carriedBlock == null) {
+      return null;
+    }
+    String name = carriedBlock.get("Name").stringValue("");
+    if (name.isEmpty() || name.equals("minecraft:air")) {
+      return null;
+    }
+    for (BlockProvider provider : BlockSpec.blockProviders) {
+      Block block = provider.getBlockByTag(name, carriedBlock);
+      if (block != null) {
+        return block;
+      }
+    }
+    return null;
+  }
+
+  @Override
+  public JsonValue toJson() {
+    JsonObject json = new JsonObject();
+    json.add("kind", "enderman");
+    json.add("position", position.toJson());
+    json.add("scale", getScale());
+    json.add("headScale", headScale);
+    json.add("pose", pose);
+    return json;
+  }
+
+  public static Entity fromJson(JsonObject json) {
+    return new EndermanEntity(json);
+  }
+
+  @Override
+  public String[] partNames() {
+    return partNames;
+  }
+
+  @Override
+  public double getScale() {
+    return scale;
+  }
+
+  @Override
+  public void setScale(double value) {
+    scale = value;
+  }
+
+  @Override
+  public void setHeadScale(double value) {
+    headScale = value;
+  }
+
+  @Override
+  public double getHeadScale() {
+    return headScale;
+  }
+
+  @Override
+  public JsonObject getPose() {
+    return pose;
+  }
+}

+package se.llbit.chunky.entity;
+
+import se.llbit.chunky.model.builder.BoxModelBuilder;
+import se.llbit.chunky.resources.Texture;
+import se.llbit.chunky.world.material.TextureMaterial;
+import se.llbit.json.JsonObject;
+import se.llbit.json.JsonValue;
+import se.llbit.math.Quad;
+import se.llbit.math.QuickMath;
+import se.llbit.math.Transform;
+import se.llbit.math.Vector3;
+import se.llbit.math.primitive.Primitive;
+import se.llbit.nbt.CompoundTag;
+import se.llbit.nbt.Tag;
+import se.llbit.util.JsonUtil;
+
+import java.util.ArrayList;
+import java.util.Collection;
+
+/**
+ * A zombie: the vanilla HumanoidModel mesh on the 64x64 zombie texture, arms held
+ * out in front as vanilla does for a zombie. Coordinates converted from vanilla
+ * model space (y-down, origin 24px above the feet) the same way as
+ * {@link EndermanEntity}.
+ */
+public class ZombieEntity extends Entity implements Poseable {
+
+  private static final Quad[] head = new BoxModelBuilder()
+    .addBox(new Vector3(-4 / 16.0, 0, -4 / 16.0), new Vector3(4 / 16.0, 8 / 16.0, 4 / 16.0), box ->
+      box.forTextureSize(64, 64).atUVCoordinates(0, 0).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  private static final Quad[] body = new BoxModelBuilder()
+    .addBox(new Vector3(-4 / 16.0, -12 / 16.0, -2 / 16.0), new Vector3(4 / 16.0, 0, 2 / 16.0), box ->
+      box.forTextureSize(64, 64).atUVCoordinates(16, 16).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  /** Right arm, pivot at the shoulder. Chunky's x is mirrored against vanilla's. */
+  private static final Quad[] rightArm = new BoxModelBuilder()
+    .addBox(new Vector3(-1 / 16.0, -10 / 16.0, -2 / 16.0), new Vector3(3 / 16.0, 2 / 16.0, 2 / 16.0), box ->
+      box.forTextureSize(64, 64).atUVCoordinates(40, 16).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  private static final Quad[] leftArm = new BoxModelBuilder()
+    .addBox(new Vector3(-3 / 16.0, -10 / 16.0, -2 / 16.0), new Vector3(1 / 16.0, 2 / 16.0, 2 / 16.0), box ->
+      box.forTextureSize(64, 64).atUVCoordinates(40, 16).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  private static final Quad[] leg = new BoxModelBuilder()
+    .addBox(new Vector3(-2 / 16.0, -12 / 16.0, -2 / 16.0), new Vector3(2 / 16.0, 0, 2 / 16.0), box ->
+      box.forTextureSize(64, 64).atUVCoordinates(0, 16).flipX()
+        .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+    ).toQuads();
+
+  private static final String[] partNames =
+    {"all", "head", "body", "left_arm", "right_arm", "left_leg", "right_leg"};
+
+  private final JsonObject pose;
+  private double scale = 1;
+  private double headScale = 1;
+
+  public ZombieEntity(Vector3 position, CompoundTag tag) {
+    super(position);
+
+    Tag rotation = tag.get("Rotation");
+    double yaw = rotation.get(0).floatValue();
+    double pitch = rotation.get(1).floatValue();
+
+    if (tag.get("IsBaby").boolValue(false)) {
+      this.scale = 0.5;
+      this.headScale = 1.5;
+    }
+
+    // Zombies always reach forward; vanilla animates both arms to about -90 degrees
+    // in model space, which is +90 in Chunky's (y-up) space.
+    Vector3 armPose = new Vector3(QuickMath.degToRad(90), 0, 0);
+
+    pose = new JsonObject();
+    pose.add("all", JsonUtil.vec3ToJson(new Vector3(0, QuickMath.degToRad(180 - yaw), 0)));
+    pose.add("head", JsonUtil.vec3ToJson(new Vector3(QuickMath.degToRad(-pitch), 0, 0)));
+    pose.add("left_arm", JsonUtil.vec3ToJson(armPose));
+    pose.add("right_arm", JsonUtil.vec3ToJson(armPose));
+  }
+
+  public ZombieEntity(JsonObject json) {
+    super(JsonUtil.vec3FromJsonObject(json.get("position")));
+    this.scale = json.get("scale").asDouble(1);
+    this.headScale = json.get("headScale").asDouble(1);
+    this.pose = json.get("pose").object();
+  }
+
+  @Override
+  public Collection<Primitive> primitives(Vector3 offset) {
+    ArrayList<Primitive> faces = new ArrayList<>();
+    TextureMaterial skin = new TextureMaterial(Texture.zombie);
+
+    Vector3 allPose = JsonUtil.vec3FromJsonArray(pose.get("all"));
+    Vector3 headPose = JsonUtil.vec3FromJsonArray(pose.get("head"));
+    Vector3 bodyPose = JsonUtil.vec3FromJsonArray(pose.get("body"));
+    Vector3 leftArmPose = JsonUtil.vec3FromJsonArray(pose.get("left_arm"));
+    Vector3 rightArmPose = JsonUtil.vec3FromJsonArray(pose.get("right_arm"));
+    Vector3 leftLegPose = JsonUtil.vec3FromJsonArray(pose.get("left_leg"));
+    Vector3 rightLegPose = JsonUtil.vec3FromJsonArray(pose.get("right_leg"));
+
+    Vector3 worldOffset = new Vector3(position.x + offset.x, position.y + offset.y, position.z + offset.z);
+    Transform worldTransform = Transform.NONE
+      .scale(scale)
+      .rotateX(allPose.x)
+      .rotateY(allPose.y)
+      .rotateZ(allPose.z)
+      .translate(worldOffset);
+
+    Transform transform = Transform.NONE
+      .rotateX(headPose.x).rotateY(headPose.y).rotateZ(headPose.z)
+      .scale(headScale)
+      .translate(0, 24 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : head) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(bodyPose.x).rotateY(bodyPose.y).rotateZ(bodyPose.z)
+      .translate(0, 24 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : body) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(rightArmPose.x).rotateY(rightArmPose.y).rotateZ(rightArmPose.z)
+      .translate(5 / 16.0, 22 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : rightArm) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(leftArmPose.x).rotateY(leftArmPose.y).rotateZ(leftArmPose.z)
+      .translate(-5 / 16.0, 22 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : leftArm) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(rightLegPose.x).rotateY(rightLegPose.y).rotateZ(rightLegPose.z)
+      .translate(1.9 / 16.0, 12 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : leg) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    transform = Transform.NONE
+      .rotateX(leftLegPose.x).rotateY(leftLegPose.y).rotateZ(leftLegPose.z)
+      .translate(-1.9 / 16.0, 12 / 16.0, 0)
+      .chain(worldTransform);
+    for (Quad quad : leg) {
+      quad.addTriangles(faces, skin, transform);
+    }
+
+    return faces;
+  }
+
+  @Override
+  public JsonValue toJson() {
+    JsonObject json = new JsonObject();
+    json.add("kind", "zombie");
+    json.add("position", position.toJson());
+    json.add("scale", getScale());
+    json.add("headScale", headScale);
+    json.add("pose", pose);
+    return json;
+  }
+
+  public static Entity fromJson(JsonObject json) {
+    return new ZombieEntity(json);
+  }
+
+  @Override
+  public String[] partNames() {
+    return partNames;
+  }
+
+  @Override
+  public double getScale() {
+    return scale;
+  }
+
+  @Override
+  public void setScale(double value) {
+    scale = value;
+  }
+
+  @Override
+  public void setHeadScale(double value) {
+    headScale = value;
+  }
+
+  @Override
+  public double getHeadScale() {
+    return headScale;
+  }
+
+  @Override
+  public JsonObject getPose() {
+    return pose;
+  }
+}

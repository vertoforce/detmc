+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ * You should have received a copy of the GNU General Public License
+ * along with Chunky.  If not, see <http://www.gnu.org/licenses/>.
+ */
+package se.llbit.chunky.entity;
+
+import se.llbit.chunky.model.builder.BoxModelBuilder;
+import se.llbit.chunky.resources.Texture;
+import se.llbit.chunky.world.material.TextureMaterial;
+import se.llbit.json.JsonObject;
+import se.llbit.json.JsonValue;
+import se.llbit.math.Quad;
+import se.llbit.math.QuickMath;
+import se.llbit.math.Transform;
+import se.llbit.math.Vector3;
+import se.llbit.math.primitive.Primitive;
+import se.llbit.nbt.CompoundTag;
+import se.llbit.nbt.Tag;
+import se.llbit.util.JsonUtil;
+
+import java.util.ArrayList;
+import java.util.Collection;
+
+/**
+ * A villager: vanilla VillagerModel (head with nose, body plus robe overlay, one
+ * crossed-arms part, two legs) on the plain 64x64 villager texture. Profession and
+ * biome overlays are not drawn. Coordinates converted from vanilla model space
+ * (y-down, origin 24px above the feet) the same way as {@link EndermanEntity}.
+ */
+public class VillagerEntity extends Entity implements Poseable {
+
+  /** Overlay layers are grown a hair so they do not z-fight with the base model. */
+  private static final double OVERLAY = 0.002;
+
+  private static Quad[] box(double x0, double y0, double z0, double x1, double y1, double z1,
+                            int u, int v, double grow) {
+    return new BoxModelBuilder()
+      .addBox(new Vector3(x0 / 16.0, y0 / 16.0, z0 / 16.0), new Vector3(x1 / 16.0, y1 / 16.0, z1 / 16.0), b ->
+        b.forTextureSize(64, 64).atUVCoordinates(u, v).flipX()
+          .addTopFace().addBottomFace().addLeftFace().addRightFace().addFrontFace().addBackFace()
+          .grow(grow)
+      ).toQuads();
+  }
+
+  private static Quad[][] parts(double grow) {
+    return new Quad[][] {
+      box(-4, 0, -4, 4, 10, 4, 0, 0, grow),        // head
+      box(-1, -3, -6, 1, 1, -4, 24, 0, grow),      // nose
+      box(-4, -12, -3, 4, 0, 3, 16, 20, grow),     // body
+      box(-4, -18, -3, 4, 0, 3, 0, 38, grow + 0.5 / 16.0), // robe
+      box(4, -6, -2, 8, 2, 2, 44, 22, grow),       // right upper arm
+      box(-8, -6, -2, -4, 2, 2, 44, 22, grow),     // left upper arm
+      box(-4, -6, -2, 4, -2, 2, 40, 38, grow),     // crossed forearms
+      box(-2, -12, -2, 2, 0, 2, 0, 22, grow),      // leg
+    };
+  }
+
+  private static final Quad[][] base = parts(0);
+  private static final Quad[][] overlay = parts(OVERLAY);
+
+  private static final int HEAD = 0, NOSE = 1, BODY = 2, ROBE = 3,
+    ARM_RIGHT = 4, ARM_LEFT = 5, FOREARMS = 6, LEG = 7;
+
+  private static final String[] partNames = {"all", "head", "body", "arms", "left_leg", "right_leg"};
+
+  private final JsonObject pose;
+  private double scale = 1;
+  private double headScale = 1;
+  /** Biome variant from VillagerData, e.g. minecraft:plains. */
+  private final String type;
+
+  public VillagerEntity(Vector3 position, CompoundTag tag) {
+    super(position);
+
+    Tag rotation = tag.get("Rotation");
+    double yaw = rotation.get(0).floatValue();
+    double pitch = rotation.get(1).floatValue();
+
+    type = tag.get("VillagerData").get("type").stringValue("minecraft:plains");
+
+    if (tag.get("Age").intValue(0) < 0) {
+      this.scale = 0.5;
+      this.headScale = 1.5;
+    }
+
+    pose = new JsonObject();
+    pose.add("all", JsonUtil.vec3ToJson(new Vector3(0, QuickMath.degToRad(180 - yaw), 0)));
+    pose.add("head", JsonUtil.vec3ToJson(new Vector3(QuickMath.degToRad(-pitch), 0, 0)));
+    // Vanilla poses the arms part at xRot -0.75 rad, which is +0.75 in Chunky's space.
+    pose.add("arms", JsonUtil.vec3ToJson(new Vector3(0.75, 0, 0)));
+  }
+
+  public VillagerEntity(JsonObject json) {
+    super(JsonUtil.vec3FromJsonObject(json.get("position")));
+    this.scale = json.get("scale").asDouble(1);
+    this.headScale = json.get("headScale").asDouble(1);
+    this.pose = json.get("pose").object();
+    this.type = json.get("type").asString("minecraft:plains");
+  }
+
+  @Override
+  public Collection<Primitive> primitives(Vector3 offset) {
+    ArrayList<Primitive> faces = new ArrayList<>();
+
+    Vector3 allPose = JsonUtil.vec3FromJsonArray(pose.get("all"));
+    Vector3 headPose = JsonUtil.vec3FromJsonArray(pose.get("head"));
+    Vector3 bodyPose = JsonUtil.vec3FromJsonArray(pose.get("body"));
+    Vector3 armsPose = JsonUtil.vec3FromJsonArray(pose.get("arms"));
+    Vector3 leftLegPose = JsonUtil.vec3FromJsonArray(pose.get("left_leg"));
+    Vector3 rightLegPose = JsonUtil.vec3FromJsonArray(pose.get("right_leg"));
+
+    Vector3 worldOffset = new Vector3(position.x + offset.x, position.y + offset.y, position.z + offset.z);
+    Transform worldTransform = Transform.NONE
+      .scale(scale)
+      .rotateX(allPose.x)
+      .rotateY(allPose.y)
+      .rotateZ(allPose.z)
+      .translate(worldOffset);
+
+    Transform headTransform = Transform.NONE
+      .rotateX(headPose.x).rotateY(headPose.y).rotateZ(headPose.z)
+      .scale(headScale)
+      .translate(0, 24 / 16.0, 0)
+      .chain(worldTransform);
+    // The nose hangs off the head, so it follows the head's pose about the head pivot.
+    Transform noseTransform = Transform.NONE
+      .translate(0, 2 / 16.0, 0)
+      .rotateX(headPose.x).rotateY(headPose.y).rotateZ(headPose.z)
+      .scale(headScale)
+      .translate(0, 24 / 16.0, 0)
+      .chain(worldTransform);
+    Transform bodyTransform = Transform.NONE
+      .rotateX(bodyPose.x).rotateY(bodyPose.y).rotateZ(bodyPose.z)
+      .translate(0, 24 / 16.0, 0)
+      .chain(worldTransform);
+    Transform armsTransform = Transform.NONE
+      .rotateX(armsPose.x).rotateY(armsPose.y).rotateZ(armsPose.z)
+      .translate(0, 21 / 16.0, -1 / 16.0)
+      .chain(worldTransform);
+    Transform rightLegTransform = Transform.NONE
+      .rotateX(rightLegPose.x).rotateY(rightLegPose.y).rotateZ(rightLegPose.z)
+      .translate(2 / 16.0, 12 / 16.0, 0)
+      .chain(worldTransform);
+    Transform leftLegTransform = Transform.NONE
+      .rotateX(leftLegPose.x).rotateY(leftLegPose.y).rotateZ(leftLegPose.z)
+      .translate(-2 / 16.0, 12 / 16.0, 0)
+      .chain(worldTransform);
+
+    // Layer 1 is the bare villager, layer 2 the biome-type overlay that carries the
+    // robe. Since 26.2 the base texture has no robe at all, so both are needed.
+    Quad[][][] layers = {base, overlay};
+    TextureMaterial[] materials = {
+      new TextureMaterial(Texture.villager), new TextureMaterial(typeTexture())
+    };
+    for (int layer = 0; layer < layers.length; layer++) {
+      Quad[][] part = layers[layer];
+      TextureMaterial material = materials[layer];
+      addAll(faces, part[HEAD], material, headTransform);
+      addAll(faces, part[NOSE], material, noseTransform);
+      addAll(faces, part[BODY], material, bodyTransform);
+      addAll(faces, part[ROBE], material, bodyTransform);
+      addAll(faces, part[ARM_RIGHT], material, armsTransform);
+      addAll(faces, part[ARM_LEFT], material, armsTransform);
+      addAll(faces, part[FOREARMS], material, armsTransform);
+      addAll(faces, part[LEG], material, rightLegTransform);
+      addAll(faces, part[LEG], material, leftLegTransform);
+    }
+
+    return faces;
+  }
+
+  private static void addAll(ArrayList<Primitive> faces, Quad[] quads,
+                             TextureMaterial material, Transform transform) {
+    for (Quad quad : quads) {
+      quad.addTriangles(faces, material, transform);
+    }
+  }
+
+  private Texture typeTexture() {
+    switch (type) {
+      case "minecraft:desert":
+        return Texture.villagerDesert;
+      case "minecraft:jungle":
+        return Texture.villagerJungle;
+      case "minecraft:savanna":
+        return Texture.villagerSavanna;
+      case "minecraft:snow":
+        return Texture.villagerSnow;
+      case "minecraft:swamp":
+        return Texture.villagerSwamp;
+      case "minecraft:taiga":
+        return Texture.villagerTaiga;
+      default:
+        return Texture.villagerPlains;
+    }
+  }
+
+  @Override
+  public JsonValue toJson() {
+    JsonObject json = new JsonObject();
+    json.add("kind", "villager");
+    json.add("position", position.toJson());
+    json.add("scale", getScale());
+    json.add("headScale", headScale);
+    json.add("pose", pose);
+    json.add("type", type);
+    return json;
+  }
+
+  public static Entity fromJson(JsonObject json) {
+    return new VillagerEntity(json);
+  }
+
+  @Override
+  public String[] partNames() {
+    return partNames;
+  }
+
+  @Override
+  public double getScale() {
+    return scale;
+  }
+
+  @Override
+  public void setScale(double value) {
+    scale = value;
+  }
+
+  @Override
+  public void setHeadScale(double value) {
+    headScale = value;
+  }
+
+  @Override
+  public double getHeadScale() {
+    return headScale;
+  }
+
+  @Override
+  public JsonObject getPose() {
+    return pose;
+  }
+}
diff --git a/chunky/src/java/se/llbit/chunky/entity/ZombieEntity.java b/chunky/src/java/se/llbit/chunky/entity/ZombieEntity.java
new file mode 100644
index 00000000..b8a16902
--- /dev/null
+++ b/chunky/src/java/se/llbit/chunky/entity/ZombieEntity.java
@@ -0,0 +1,229 @@
